rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Función para verificar autenticación básica
    function isAuthenticated() {
      return request.auth != null;
    }

    // Objetos perdidos / encontrados
    match /posts/{postId}/{imageName} {
      allow read: if true;
      // Permitimos creación y sobrescritura de imágenes en publicaciones.
      // Para la sobrescritura, verificamos de forma segura que el uid coincida con el dueño original guardado en los metadatos.
      allow write: if isAuthenticated()
                   && (resource == null || resource.metadata.owner == request.auth.uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/octet-stream');
    }

    // Imágenes en chats
    match /chats/{chatId}/{messageId} {
      allow read: if isAuthenticated();
      // Asegurar autenticación, tamaño menor a 5MB, tipo de imagen y que el usuario sea miembro del chat.
      // Dado que Storage rules no puede leer Realtime Database, la validación de pertenencia en Storage
      // se realiza mediante una consulta a Firestore en caso de persistir allí la información de chats/miembros.
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && firestore.exists(/databases/(default)/documents/chats/$(chatId)/members/$(request.auth.uid));
    }

    // Fotos de perfil
    match /users/{userId}/profile_image {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/octet-stream');
    }

    // Versión optimizada (WebP)
    match /users/{userId}/profile_image.webp {
      allow read: if true;
      allow write: if false; // Solo accesible vía Admin SDK (Cloud Functions)
    }
  }
}