rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Función para verificar autenticación básica
    function isAuthenticated() {
      return request.auth != null;
    }

    // Objetos perdidos / encontrados
    match /posts/{postId}/{imageName} {
      allow read: if true;
      
      // Permitimos la creación inicial a cualquier usuario autenticado (se procesará a WebP en handlePostImage)
      allow create: if isAuthenticated()
                    && request.resource.size < 5 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/octet-stream');
      
      // Para actualización (update) exigimos que sea estrictamente formato WebP y < 3MB (comprimido)
      allow update: if isAuthenticated()
                    && request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType == 'image/webp';
                    
      // Permitimos la eliminación (la autoría final se valida en el backend y base de datos)
      allow delete: if isAuthenticated();
    }

    // Fotos de perfil
    match /users/{userId}/profile_image {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/octet-stream');
    }

    // Versión optimizada (WebP)
    match /users/{userId}/profile_image.webp {
      allow read: if true;
      allow write: if false; // Solo accesible vía Admin SDK (Cloud Functions)
    }

    // Imágenes en chats
    match /chats/{chatId}/{imageId} {
      allow read: if isAuthenticated();
      // Debido a limitaciones de Firebase Storage, no es posible leer Realtime Database directamente desde las reglas.
      // Validamos autenticación, formato estricto de imagen WebP y un tamaño máximo razonable de 3MB.
      allow write: if isAuthenticated()
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType == 'image/webp';
    }
  }
}