rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función reutilizable y centralizada
    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Objetos perdidos / encontrados
    match /posts/{fileName} {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png)');
    }
    
    // Fotos de perfil
    match /users/{userId}/profile_image {
      allow read: if isVerifiedUser();
      allow write: if isVerifiedUser() 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png)');
    }

    // Versión optimizada (WebP)
    match /users/{userId}/profile_image.webp {
      allow read: if isVerifiedUser();
      allow write: if false; // Solo accesible vía Admin SDK (Cloud Functions)
    }
  }
}