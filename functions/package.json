{
  "name": "ulf-functions",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:unit",
    "test:unit": "npm run build && jest --runInBand",
    "test:integration": "npm run build && node tests/integration/patchCompiledFirebaseAdmin.js && node tests/integration/runFirebaseEmulators.js",
    "test:all": "npm run test:unit && npm run test:integration",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only database,functions,storage",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/translate": "^9.3.0",
    "@google-cloud/vision": "^5.3.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5",
    "geofire-common": "^6.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "firebase": "^12.13.0",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^15.18.0",
    "jest": "^30.3.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
