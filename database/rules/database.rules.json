{
    "rules": {
        "centers": {
            ".read": "auth != null",
            ".indexOn": [
                "is_active"
            ],
            "$center_id": {
                ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
                ".validate": "newData.hasChildren(['id', 'name', 'email_domains', 'boundary_coords', 'location', 'is_active']) && newData.child('location').hasChildren(['lat', 'lng']) && newData.child('location/lat').isNumber() && newData.child('location/lng').isNumber()"
            }
        },
        "users": {
            "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".read": "auth != null && auth.uid === $uid",
                ".validate": "newData.hasChildren(['id', 'center_id', 'role', 'email', 'name']) && newData.child('id').val() === $uid && (newData.child('updated_at').val() === now || data.child('updated_at').val() === newData.child('updated_at').val()) && (!newData.child('photoUrl').exists() || newData.child('photoUrl').isString())",
                "role": {
                    ".validate": "(!data.exists() && newData.val() === 'student') || (data.exists() && newData.val() === data.val())"
                },
                "name": {
                    ".validate": "newData.isString() && newData.val().length > 0"
                },
                "email": {
                    ".validate": "newData.isString() && newData.val().length > 0"
                },
                "id": {
                    ".validate": "newData.isString() && newData.val().length > 0"
                },
                "center_id": {
                    ".validate": "root.child('centers').child(newData.val()).exists()"
                },
                "settings": {
                    ".read": "auth != null && auth.uid === $uid",
                    ".write": "auth != null && auth.uid === $uid",
                    "language": {
                        ".validate": "newData.isString() && newData.val().matches(/^(es|en|ca)$/)"
                    },
                    "theme": {
                        ".validate": "newData.isString() && newData.val().matches(/^(light|dark|system)$/)"
                    },
                    "notificationsEnabled": {
                        ".validate": "newData.isBoolean()"
                    },
                    "pushNotificationsEnabled": {
                        ".validate": "newData.isBoolean()"
                    },
                    "push_notifications": {
                        ".read": "auth != null && auth.uid === $uid",
                        ".write": "auth != null && auth.uid === $uid",
                        ".validate": "newData.isBoolean()"
                    },
                    "dark_mode": {
                        ".validate": "newData.isBoolean()"
                    }
                },
                "preferredLanguage": {
                    ".write": "auth != null && auth.uid === $uid",
                    ".validate": "newData.isString() && newData.val().matches(/^(es|en|ca)$/)"
                },
                "notifications": {
                    ".read": "auth != null && auth.uid === $uid",
                    ".write": "auth != null && auth.uid === $uid",
                    ".indexOn": ["read"]
                },
                "legal": {
                    ".read": "auth != null && auth.uid === $uid",
                    ".write": "auth != null && auth.uid === $uid",
                    ".validate": "newData.hasChildren(['termsAccepted', 'privacyAccepted', 'acceptedAt'])",
                    "termsAccepted": {
                        ".validate": "newData.isBoolean()"
                    },
                    "privacyAccepted": {
                        ".validate": "newData.isBoolean()"
                    },
                    "acceptedAt": {
                        ".validate": "newData.isNumber()"
                    },
                    "$other": {
                        ".validate": false
                    }
                }
            }
        },
        "posts": {
            ".read": "auth != null && auth.token.email_verified === true",
            ".indexOn": [
                "center_id",
                "type",
                "status",
                "category",
                "user_id",
                "created_at",
                "coords/geohash"
            ],
            "$post_id": {
                ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || data.child('user_id').val() === auth.uid)",
                ".validate": "newData.hasChildren(['id', 'user_id', 'center_id', 'type', 'title', 'category', 'status', 'coords', 'created_at', 'updated_at', 'is_deleted']) && newData.child('id').val() === $post_id && newData.child('coords').hasChildren(['lat', 'lng', 'geohash']) && newData.child('coords/lat').isNumber() && newData.child('coords/lng').isNumber() && newData.child('updated_at').val() === now && (!newData.child('imageUrl').exists() || newData.child('imageUrl').isString())",
                "user_id": {
                    ".validate": "!data.exists() || newData.val() === data.val()"
                },
                "category": {
                    ".validate": "newData.isString() && newData.val().matches(/^(accessories|clothes|devices|wallets|keys|bags|study|others)$/)"
                },
                "type": {
                    ".validate": "newData.isString() && newData.val().matches(/^(lost|found)$/)"
                },
                "status": {
                    ".validate": "newData.isString() && newData.val().matches(/^(active|matched|returned|rejected)$/)"
                },
                "title": {
                    ".validate": "newData.isString() && newData.val().length > 0"
                },
                "description": {
                    ".validate": "!newData.exists() || newData.isString()"
                }
            }
        },
        "active_posts": {
            ".read": "auth != null",
            "$center_id": {
                ".read": "auth != null",
                ".indexOn": [
                    ".value"
                ],
                "$type": {
                    ".read": "auth != null",
                    ".indexOn": [
                        ".value"
                    ]
                }
            }
        },
        "post_views": {
            "$post_id": {
                ".indexOn": [
                    "timestamp"
                ],
                "$user_id": {
                    ".read": "auth != null && auth.token.email_verified === true && (auth.uid === $user_id || root.child('posts').child($post_id).child('user_id').val() === auth.uid)",
                    ".write": "auth != null && auth.token.email_verified === true && auth.uid === $user_id && root.child('posts').child($post_id).exists() && root.child('posts').child($post_id).child('user_id').val() !== auth.uid",
                    ".validate": "newData.hasChildren(['timestamp']) && newData.child('timestamp').isNumber() && newData.child('timestamp').val() <= now"
                }
            }
        },
        "user_chats": {
            "$user_id": {
                ".read": "auth != null && auth.uid === $user_id",
                ".write": "false"
            }
        },
        "chats": {
            ".indexOn": [
                "center_id",
                "post_id"
            ],
            "$chat_id": {
                ".read": "auth != null && auth.token.email_verified === true && data.child('members').child(auth.uid).val() === true",
                ".write": "auth != null && auth.token.email_verified === true && (!data.exists() || data.child('members').child(auth.uid).val() === true)",
                ".validate": "newData.hasChildren(['id', 'center_id', 'post_id', 'members', 'created_at']) && newData.child('members').child(auth.uid).val() === true && newData.child('created_at').isNumber()"
            }
        },
        "messages": {
            "$chat_id": {
                ".read": "auth != null && auth.token.email_verified === true && root.child('chats').child($chat_id).child('members').child(auth.uid).val() === true",
                "$message_id": {
                    ".write": "auth != null && auth.token.email_verified === true && root.child('chats').child($chat_id).child('members').child(auth.uid).val() === true && !data.exists()",
                    ".validate": "newData.hasChildren(['id', 'sender_id', 'timestamp']) && newData.child('sender_id').val() === auth.uid && newData.child('timestamp').isNumber() && newData.child('timestamp').val() <= now && (!newData.child('messageType').exists() || (newData.child('messageType').isString() && newData.child('messageType').val().matches(/^(text|image)$/))) && (newData.child('messageType').val() === 'image' ? newData.child('imageUrl').isString() : newData.child('text').isString())"
                }
            }
        }
    }
}
